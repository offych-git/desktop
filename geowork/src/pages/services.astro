---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
const services=[
 {id:'visibility',badge:'01 / VISIBILITY',title:'Know where your brand stands in AI search.',copy:'A structured baseline built around the questions real prospective customers ask. We compare your brand with competitors, check citations, and identify the opportunities worth pursuing.',bullets:['Priority buyer-prompt research','AI mention and citation snapshots','Competitor Share of Voice comparison','Clear baseline and an action roadmap'],visual:'AI?'},
 {id:'technical',badge:'02 / TECHNICAL GEO',title:'Make your website understandable to machines.',copy:'Technical hygiene is the starting point. We improve crawl access, canonical URLs, relevant structured data and the clarity of the information AI-powered search can extract.',bullets:['Robots, XML sitemap, indexing and internal links','Schema.org entities for the right page types','Accurate service, organization and author information','Optional structured feeds and machine-readable endpoints'],visual:'{ }'},
 {id:'content',badge:'03 / CONTENT & AUTHORITY',title:'Publish answers worth referencing.',copy:'Great AI visibility starts with useful, verifiable information. We develop expert-led pages and articles designed to answer buyer questions in plain language.',bullets:['Topic and question research mapped to buyer intent','Blog-first articles with clear expertise and sources','Helpful FAQs, comparisons and explainers','Distribution planning for LinkedIn, Medium and video'],visual:'✳'},
 {id:'measurement',badge:'04 / MEASUREMENT',title:'Turn visibility data into better decisions.',copy:'We look beyond a single screenshot. Our recurring reviews track a defined prompt set, cited sources and qualified traffic where analytics are available.',bullets:['Tracked prompts and citation observations','Recurring competitor benchmarks','Google Analytics and organic traffic context','Monthly or twice-monthly reports by plan'],visual:'↗'}
];
---
<BaseLayout title="GEO & AI Search Optimization Services | GeoWork" description="GeoWork services: AI visibility audits, technical GEO, AEO, structured data, expert content, authority building and AI citation tracking.">
  <section class="page-hero"><div class="container"><div class="eyebrow"><span class="eyebrow-dot"></span>OUR SERVICES</div><h1>A better presence in <span class="accent">AI-powered search.</span></h1><p>We connect technical access, clear expertise, helpful answers and continuous measurement to make your brand a stronger candidate for AI recommendations.</p><a class="button button-purple" href="/contact">Request a visibility review ↗</a></div></section>
  <section class="section"><div class="container">{services.map((s)=><article class="feature-row" id={s.id}><div><div class="eyebrow"><span class="eyebrow-dot"></span>{s.badge}</div><h2>{s.title}</h2><p>{s.copy}</p><ul>{s.bullets.map((b)=><li>{b}</li>)}</ul><a class="link-arrow" href="/contact">Talk about this service ↗</a></div><div class="feature-illustration"><span>{s.visual}</span></div></article>)}</div></section>
  <section class="section-small soft-section"><div class="container"><div class="section-head"><div class="eyebrow"><span class="eyebrow-dot"></span>WHAT WE DON'T PROMISE</div><h2>Real work, <span class="accent">not invented certainty.</span></h2><p>AI systems decide what to show. We cannot buy or guarantee a citation, placement or recommendation. We can give you a better technical foundation, more useful public information and a measurable improvement process.</p></div><a href="/how-it-works" class="link-arrow">Understand our process ↗</a></div></section>
  <CTA />
</BaseLayout>
