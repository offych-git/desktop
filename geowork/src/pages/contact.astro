---
import BaseLayout from '../layouts/BaseLayout.astro';
const plan = Astro.url.searchParams.get('plan') ?? '';
const allowedPlans=['Foundation','Growth','Authority'];
const selected=allowedPlans.includes(plan)?plan:'';
---
<BaseLayout title="Contact GeoWork | Request an AI Visibility Review" description="Contact GeoWork at contact@geowork.us or request a GEO visibility review. Tell us your website, target market, and AI search goals.">
<section class="page-hero"><div class="container"><div class="eyebrow"><span class="eyebrow-dot"></span>LET'S CONNECT</div><h1>Your brand's next chapter <span class="accent">starts here.</span></h1><p>Tell us about your company. We'll discuss which customer questions matter and where AI visibility could help.</p></div></section>
<section class="section"><div class="container contact-layout">
  <div class="contact-details"><div class="eyebrow"><span class="eyebrow-dot"></span>REACH OUT</div><h2>Let's make your business <span class="accent">easier to find.</span></h2><p>Share your website, goals and the markets you care about. No fabricated guarantees — just a useful starting conversation.</p><p><strong>Send us an email</strong></p><a class="contact-link" href="mailto:contact@geowork.us">contact@geowork.us ↗</a><div class="card" style="margin-top:36px"><h3>What happens next?</h3><p>We'll review your request and follow up to discuss your current visibility, target prompts and the right program for your needs.</p><p style="font-size:.82rem;margin-bottom:0">Based in the United States market · Serving U.S. businesses</p></div></div>
  <div class="contact-form"><h3 style="margin-bottom:7px">Request a visibility review</h3><p style="font-size:.9rem">Tell us a little about your business.</p>
    <form name="geowork-leads" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/thanks">
      <input type="hidden" name="form-name" value="geowork-leads" />
      <p style="display:none"><label>Don't fill this out if you're human: <input name="bot-field" /></label></p>
      <label for="name">Your name *</label><input id="name" name="name" required autocomplete="name" maxlength="120" />
      <label for="email">Work email *</label><input type="email" id="email" name="email" required autocomplete="email" maxlength="200" />
      <label for="company">Company</label><input id="company" name="company" autocomplete="organization" maxlength="150" />
      <label for="website">Website URL *</label><input type="url" id="website" name="website" placeholder="https://yourcompany.com" required maxlength="300" />
      <label for="plan">Plan you're considering</label><select id="plan" name="plan"><option value="">Not sure yet</option>{allowedPlans.map(p=><option value={p} selected={p===selected}>{p}</option>)}</select>
      <label for="message">What's your biggest AI search challenge?</label><textarea id="message" name="message" maxlength="4000" placeholder="What you sell, where you compete, and what you want to improve..."></textarea>
      <label style="font-weight:500;font-size:.77rem;margin-bottom:17px"><input style="display:inline;width:auto;margin:0 6px 0 0" type="checkbox" name="consent" required /> I agree to be contacted about my request and have read the <a style="color:#6248d7;text-decoration:underline" href="/privacy">privacy notice</a>.</label>
      <button type="submit" class="button button-purple">Send my request ↗</button>
      <p style="font-size:.75rem;margin:14px 0 0">Form delivery requires deployment to Netlify with Forms enabled. On other hosts, email us directly at <a href="mailto:contact@geowork.us" style="color:#674be0;text-decoration:underline">contact@geowork.us</a>.</p>
    </form>
  </div>
</div></section>
</BaseLayout>
