---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
const stages=[
 {when:'MONTH 01',name:'Find the baseline',description:'Identify the highest-value prompts, current mentions, competitors and technical gaps. Approve a content plan and measurable priorities.',items:['Discovery and kickoff workshop','AI visibility audit and competitor benchmark','Technical and structured data audit','Content roadmap and first optimizations']},
 {when:'MONTHS 02–03',name:'Build the foundation',description:'Publish answer-focused content, strengthen identity and expert signals, and start creating a more consistent citation footprint.',items:['Blog-first articles and content distribution','Service, expert and trust information','Structured data improvements','Initial reporting and recalibration']},
 {when:'MONTHS 04–12',name:'Compound the gains',description:'Keep improving based on what the tracked prompts, competitors, citations and analytics actually show.',items:['Monthly optimization sprints','New content and authority opportunities','Recurring AI Share of Voice measurement','Ongoing reports and strategy adjustment']}
];
---
<BaseLayout title="How GeoWork Works | 12-Month GEO Roadmap" description="From AI visibility audits to technical GEO, expert content, citation tracking and ongoing optimization — discover the GeoWork process.">
  <section class="page-hero"><div class="container"><div class="eyebrow"><span class="eyebrow-dot"></span>OUR METHOD</div><h1>From first audit to <span class="accent">lasting momentum.</span></h1><p>A focused 12-month program that measures where you stand, improves what matters and tracks your direction in AI search.</p><a href="/contact" class="button button-purple">Start with a visibility review ↗</a></div></section>
  <section class="section"><div class="container"><div class="section-head"><div class="eyebrow"><span class="eyebrow-dot"></span>THE ROADMAP</div><h2>A plan that <span class="accent">keeps moving.</span></h2></div>
    <div class="grid-3">{stages.map((s,i)=><div class="card"><span class="pill">{s.when}</span><div class={'icon-box '+(['','cyan','green'][i])} style="margin-top:23px">{'0'+(i+1)}</div><h3>{s.name}</h3><p>{s.description}</p><ul style="padding-left:20px;color:#46516a;font-size:.9rem">{s.items.map(item=><li style="margin:8px 0">{item}</li>)}</ul></div>)}</div>
    <p class="muted" style="margin-top:26px;font-size:.85rem">Timing is indicative, not guaranteed. Outcomes vary based on your current footprint, market and AI platform changes.</p>
  </div></section>
  <section class="section soft-section"><div class="container"><div class="section-head"><div class="eyebrow"><span class="eyebrow-dot"></span>WHAT WE MEASURE</div><h2>Beyond rankings and <span class="accent">vanity numbers.</span></h2><p>Every tracked prompt is a real question a buyer could ask. Our reporting connects observations in AI answers to site traffic where data is available.</p></div><div class="grid-3"><div class="card"><div class="icon-box">◎</div><h3>AI answer presence</h3><p>Are you mentioned, how accurately are you described, and which tracked prompts include you?</p></div><div class="card"><div class="icon-box cyan">↗</div><h3>Sources and citations</h3><p>Which sources appear in AI answers, and what gaps exist between your brand and competitors?</p></div><div class="card"><div class="icon-box green">▤</div><h3>Quality traffic</h3><p>When your analytics can identify referral sources, are relevant visitors engaging and converting?</p></div></div></div></section>
  <section class="section"><div class="container"><div class="section-head"><div class="eyebrow"><span class="eyebrow-dot"></span>THE WORKING RELATIONSHIP</div><h2>A clear scope. <span class="accent">Regular visibility.</span></h2></div><div class="grid-3"><div class="card"><h3>Kickoff</h3><p>Discovery, goals, prompt priorities and baseline definition.</p></div><div class="card"><h3>Reporting</h3><p>One monthly report for Foundation, two for Growth and Authority; an additional strategy call on Authority.</p></div><div class="card"><h3>Support</h3><p>Telegram chat support during business hours, included across the plans.</p></div></div></div></section>
  <CTA />
</BaseLayout>
